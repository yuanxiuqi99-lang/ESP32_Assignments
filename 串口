int led = 2;
bool ledState = false;

void setup()
{
  pinMode(led, OUTPUT);

  Serial.begin(115200);

  Serial.println("ESP32 Ready");
}

void loop()
{
  if(Serial.available())
  {
    String cmd = Serial.readStringUntil('\n');

    cmd.trim();

    if(cmd == "1")
    {
      ledState = !ledState;

      digitalWrite(led, ledState);

      if(ledState)
      {
        Serial.println("LED1亮");
      }
      else
      {
        Serial.println("LED1灭");
      }
    }
  }
}
