int led1 = 2;
int led2 = 4;

bool state1 = false;
bool state2 = false;

void setup()
{
  pinMode(led1,OUTPUT);
  pinMode(led2,OUTPUT);

  Serial.begin(115200);
}

void loop()
{
  if(Serial.available())
  {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if(cmd=="1")
    {
      state1=!state1;
      digitalWrite(led1,state1);

      Serial.println("LED1切换");
    }

    else if(cmd=="2")
    {
      state2=!state2;
      digitalWrite(led2,state2);

      Serial.println("LED2切换");
    }

    else
    {
      Serial.println("无效指令");
    }
  }
}
