String password[4]={"AA","BB","CC","DD"};

int stepIndex=0;

void setup()
{
  Serial.begin(115200);
}

void loop()
{
  if(Serial.available())
  {
    String input=Serial.readStringUntil('\n');

    input.trim();

    if(input==password[stepIndex])
    {
      stepIndex++;

      if(stepIndex==4)
      {
        Serial.println("密码正确");
        stepIndex=0;
      }
    }
    else
    {
      Serial.println("密码错误");
      stepIndex=0;
    }
  }
}
