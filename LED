int leds[] = {2,4,5,18};
int ledCount = 4;

void setup()
{
  for(int i=0;i<ledCount;i++)
  {
    pinMode(leds[i],OUTPUT);
  }
}

void loop()
{
  for(int i=0;i<ledCount;i++)
  {
    digitalWrite(leds[i],HIGH);
    delay(200);
    digitalWrite(leds[i],LOW);
  }

  for(int i=ledCount-1;i>=0;i--)
  {
    digitalWrite(leds[i],HIGH);
    delay(200);
    digitalWrite(leds[i],LOW);
  }
}
